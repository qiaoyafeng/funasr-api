# FunASR API Server Environment Configuration
# Copy this file to .env and modify as needed

# Timezone
TZ=Asia/Shanghai

# ModelScope cache directory (mapped into container)
MODELSCOPE_CACHE=./model_cache

# Server settings
FUNASR_HOST=0.0.0.0
FUNASR_PORT=8000

# Engine: "auto" (PyTorch AutoModel) or "vllm" (high-performance GPU)
FUNASR_ENGINE=auto

# Model selection
# For auto engine: sensevoice, paraformer, paraformer-en, fun-asr-nano
# For vllm engine: fun-asr-nano
FUNASR_MODEL=sensevoice

# Device: cuda, cpu, mps
FUNASR_DEVICE=cpu

# vLLM specific settings (only used when FUNASR_ENGINE=vllm)
FUNASR_GPU_MEMORY_UTILIZATION=0.8
FUNASR_TENSOR_PARALLEL_SIZE=1
# FUNASR_MAX_MODEL_LEN=4096

# Speaker diarization (default: false)
FUNASR_ENABLE_SPK=false

# Default language (optional, auto-detect if empty)
# Examples: 中文, English, 日本語, 한국어
# FUNASR_LANGUAGE=中文

# Default hotwords (comma-separated)
# FUNASR_HOTWORDS=张三,北京

# Realtime streaming settings
FUNASR_PARTIAL_WINDOW_SEC=15.0
FUNASR_DECODE_INTERVAL=0.48
FUNASR_CHUNK_MS=720
FUNASR_ROLLBACK_CHARS=8

# Log directory (mapped to container /app/logs)
FUNASR_LOG_DIR=logs
